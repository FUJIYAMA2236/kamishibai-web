{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kamishibai",
  "version": "0.4.3",
  "identifier": "app.kamishibai.desktop",
  "build": {
    "frontendDist": "../app-dist",
    "beforeDevCommand": "node scripts/prepare-app.js",
    "beforeBuildCommand": "node scripts/prepare-app.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kamishibai",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost; worker-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Markdown で書いて GUI で整えるスライドツール",
    "fileAssociations": [
      {
        "ext": ["kami"],
        "name": "Kamishibai",
        "description": "Kamishibai のスライド",
        "role": "Editor",
        "mimeType": "application/x-kamishibai"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "languages": ["Japanese", "English"] }
    }
  }
}
